{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["electron.vite.config.ts", "vitest.config.ts", "playwright.config.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/renderer/src/lib/api.ts", "src/renderer/src/lib/format.ts", "src/renderer/src/lib/lockState.ts", "src/renderer/src/lib/amounts.ts", "src/renderer/src/lib/dashboardShape.ts", "src/renderer/src/lib/optimizerLogic.ts", "src/renderer/src/lib/importLogic.ts", "src/renderer/src/lib/goalText.ts", "src/renderer/src/lib/months.ts", "tests/**/*"]
}
